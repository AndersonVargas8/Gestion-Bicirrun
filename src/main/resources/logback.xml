<configuration>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/application.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.app.springapp.service.CupoService" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
    </logger>

    <logger name="com.app.springapp.service.EstudianteService" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
    </logger>

     <logger name="com.app.springapp.service.EstacionService" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>

</configuration>
